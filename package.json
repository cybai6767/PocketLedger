{
  "name": "accounting-tool",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "dev:tauri": "cross-env NUXT_TAURI=true nuxt dev --port 1420",
    "build": "nuxt build",
    "generate:tauri": "cross-env NUXT_TAURI=true nuxt generate",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "tauri": "tauri",
    "tauri:android:init": "tauri android init --ci --skip-targets-install",
    "tauri:android:build": "bash scripts/tauri-android-arch.sh",
    "tauri:android:build:standard": "tauri android build --debug --apk --target aarch64 --ci",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:all": "npm test && cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "better-sqlite3": "^13.0.3",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "nuxt": "^4.5.2",
    "vue": "^3.5.38",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/better-sqlite3": "^9.6.0",
    "@vue/eslint-config-typescript": "^14.8.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.5.0",
    "eslint-plugin-vue": "^10.9.2",
    "jiti": "^2.7.0",
    "typescript": "~6.0.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.5"
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
