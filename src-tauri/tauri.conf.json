{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "我的记账本",
  "version": "1.0.0",
  "identifier": "com.axiaobo.accountingtool",
  "build": {
    "frontendDist": "../.output/public",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:tauri",
    "beforeBuildCommand": "npm run generate:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "我的记账本",
        "width": 1180,
        "height": 760,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
